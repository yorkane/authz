location ^~ /_authz/ {
    default_type text/html;
    # 控制面 API 的体积上限：正文改写/JSON 请求都很小，唯一的大请求是
    # 文件管理的 multipart 上传（/api/files/upload 流式落盘，不驻留内存）。
    # 该值是整体请求的硬上限，防止上传把磁盘写满；单文件另有 2GB 配额。
    client_max_body_size 2048m;
    content_by_lua_block {
        require("resty.authz.router"):handle()
    }
}

# ── 文件浏览模块 ────────────────────────────────────────────────
# 目录列表由 Web UI（/_authz/apps/ 内置应用 files）通过 /_authz/api/files
# 获取；/_authz/files/ 只负责按路径吐出文件字节（预览与下载同源复用）。
# 内容根是容器内 /files 目录（默认空，部署时用 -v <宿主目录>:/files 挂载；
# 必须与 AUTHZ_FILES_ROOT 保持一致）。路径挂在 /_authz/ 命名空间下，
# 避免与业务代理的 /files 前缀冲突；最长前缀匹配优先于 ^~ /_authz/。
#
# CSP sandbox：被浏览的 HTML/资源在独立源中渲染，脚本可运行但不携带
# 网关会话 Cookie，避免被浏览的页面访问 /_authz/api/*。
location = /_authz/files {
    return 301 /_authz/files/;
}

location = /_authz/files/ {
    return 302 /_authz/apps/;
}

location ^~ /_authz/files/ {
    alias /files/;
    # 大文件（视频/镜像）用线程池异步读，慢客户端不阻塞 worker。
    aio threads;
    # 缓存打开的文件句柄与 stat 结果：目录浏览和缩略图会反复命中同一批文件。
    open_file_cache max=2000 inactive=30s;
    open_file_cache_valid 60s;
    open_file_cache_min_uses 2;
    open_file_cache_errors on;
    add_header Content-Security-Policy "sandbox allow-scripts allow-forms allow-popups allow-modals" always;
    add_header X-Content-Type-Options "nosniff" always;
    expires 1h;
    # 预览请求（?authz_preview=1）注入 ESC 转发脚本，见 nginx.conf 的
    # $authz_files_head_close map；其它请求替换为等价文本，字节不变。
    # 依赖 text/html 默认命中 sub_filter；</head> 缺失或大小写变体不注入，
    # 那种页面用预览头部的关闭按钮退出。
    sub_filter '</head>' $authz_files_head_close;
    sub_filter_once on;
    access_by_lua_block {
        local authz = require "resty.authz"
        require("resty.authz.db").open(authz.config.db_path)
        -- 免登录放行：合法 API Key（x-api-key）直接取页面与资源，
        -- 不签发会话 Cookie。Agent 给每个请求带上 x-api-key 即可打开管理页面。
        if require("resty.authz.api_key").authorize_request() then return end
        local session = require "resty.authz.session"
        local token = session.get_request_token()
        local current = token and session.get(token)
        if not current then
            return ngx.redirect("/_authz/login?next=" .. ngx.escape_uri(ngx.var.request_uri))
        end
        -- guest 是最小权限角色：管理页面、静态资源与文件浏览都不属于它，
        -- 统一引导到唯一可用的只读诊断页（页面自身会重新认证与鉴权）。
        if require("resty.authz.api.common").is_guest(current) then
            return ngx.redirect("/_authz/guest")
        end
    }
}

# ── 对象存储（S3）浏览模块 ─────────────────────────────────────
# 目录列表走 /_authz/api/s3（router），这里只按路径吐对象字节：内容在远端 S3
# 服务上，nginx 无法静态 alias，所以用 content_by_lua 流式代理（resty.http →
# ngx.print），并把认证做成与 /_authz/files/ 完全同款的 access 门（会话或 API Key，
# guest 一律引导到诊断页）。路径挂在 /_authz/ 下避免与业务代理的 /s3 前缀冲突。
location = /_authz/s3 {
    return 301 /_authz/s3/;
}

location ^~ /_authz/s3/ {
    # 大对象（视频）用线程池读；慢客户端不阻塞 worker（ngx.flush 已经逐块推送）。
    client_max_body_size 0;
    # CSP 与 nosniff 由 s3_proxy 自己下发（add_header 会叠加出重复头，reject() 分支也需要它们）。
    proxy_buffering off;
    access_by_lua_block {
        local authz = require "resty.authz"
        require("resty.authz.db").open(authz.config.db_path)
        -- 免登录放行：合法 API Key 直接取对象，与文件浏览一致。
        if require("resty.authz.api_key").authorize_request() then return end
        local session = require "resty.authz.session"
        local token = session.get_request_token()
        local current = token and session.get(token)
        if not current then
            return ngx.redirect("/_authz/login?next=" .. ngx.escape_uri(ngx.var.request_uri))
        end
        if require("resty.authz.api.common").is_guest(current) then
            return ngx.redirect("/_authz/guest")
        end
    }
    content_by_lua_block {
        require("resty.authz.s3_proxy").serve()
    }
}

location / {
    set $authz_target "";
    set $authz_user   "";
    set $authz_source "";
    set $authz_identity "";
    set $authz_websocket "0";
    set $authz_upgrade "";
    set $authz_connection "";
    set $authz_upstream_host "";
    set $authz_proxy_forwarded_host "";
    set $authz_forwarded_proto "";
    set $authz_forwarded_port "";
    set $authz_real_ip "";
    set $authz_forwarded_for "";
    set $authz_origin "";
    set $authz_forwarded "";
    set $authz_upstream_ssl_name "";
    set $authz_upstream_cookie "";
    # 发给上游的 Accept-Encoding 独立成变量：正文改写需要上游返回未压缩字节，
    # 但若用 ngx.req.set_header 直接改请求头表，nginx 的 gzip 模块会按同一个
    # 值判定「客户端不要压缩」，于是配了改写的绑定整体丢掉网关压缩。变量只影响
    # 上游请求，客户端声明保持原样。
    set $authz_accept_encoding $http_accept_encoding;
    access_by_lua_block {
        require("resty.authz").access()
    }
    proxy_pass $authz_target;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name $authz_upstream_ssl_name;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth 5;
    proxy_set_header Host              $authz_upstream_host;
    proxy_set_header X-Real-IP         $authz_real_ip;
    proxy_set_header X-Forwarded-For   $authz_forwarded_for;
    proxy_set_header X-Forwarded-Proto $authz_forwarded_proto;
    proxy_set_header X-Forwarded-Port  $authz_forwarded_port;
    proxy_set_header X-Authz-User      $authz_user;
    proxy_set_header X-Authz-Source    $authz_source;
    proxy_set_header X-Authz-Identity  $authz_identity;
    proxy_set_header X-Authz-Key       "";
    proxy_set_header X-API-Key         "";
    proxy_set_header X-Role-Key        "";
    proxy_set_header Cookie            $authz_upstream_cookie;
    proxy_set_header X-Forwarded-Host  $authz_proxy_forwarded_host;
    proxy_set_header Origin            $authz_origin;
    proxy_set_header Forwarded         $authz_forwarded;
    proxy_set_header Upgrade           $authz_upgrade;
    proxy_set_header Connection        $authz_connection;
    proxy_set_header Accept-Encoding   $authz_accept_encoding;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    # SSE/流式响应告知下游代理（SLB/边缘 nginx）不要缓冲；普通响应不带此头。
    add_header X-Accel-Buffering $sse_no_buffer always;
    # 绑定级响应改写（状态码 / 响应头 / 正文），见 resty.authz.gateway.rewrite。
    header_filter_by_lua_block {
        require("resty.authz.gateway.rewrite").header_filter()
    }
    body_filter_by_lua_block {
        require("resty.authz.gateway.rewrite").body_filter()
    }
    # 请求结束（含客户端中途断开）时归还正文改写缓冲配额。
    log_by_lua_block {
        require("resty.authz.gateway.rewrite").release_buffer()
    }
}

# 用户自定义附加配置（外置可编辑：conf/server_inc.conf，
# 由入口脚本在文件缺失时自动生成默认内容；位于本 server 配置最末尾，
# 可同时追加 location / 覆盖网关行为，修改后重建或重启容器生效）
include server_inc.conf;

# HTTPS bindings that explicitly disable certificate verification are routed
# here by resty.authz after authentication and Casbin authorization.  Keep
# this named location private so it cannot bypass the gateway access phase.
location @authz_proxy_insecure {
    internal;
    proxy_pass $authz_target;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name $authz_upstream_ssl_name;
    proxy_ssl_verify off;
    proxy_set_header Host              $authz_upstream_host;
    proxy_set_header X-Real-IP         $authz_real_ip;
