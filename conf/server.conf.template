absolute_redirect off;

location = /_authz {
    return 301 /_authz/apps/;
}

location = /_authz/apps {
    return 301 /_authz/apps/;
}

location = /_authz/apps/ {
    alias /usr/local/openresty/nginx/html/admin/;
    index index.html;
    default_type text/html;
    ssi on;
    gzip on;
    gzip_comp_level 7;
    gzip_vary on;
    gzip_min_length 256;
    expires off;
    access_by_lua_block {
        local authz = require "resty.authz"
        require("resty.authz.db").open(authz.config.db_path)
        local session = require "resty.authz.session"
        local token = session.get_request_token()
        local current = token and session.get(token)
        if not current then
            return ngx.redirect("/_authz/login?next=" .. ngx.escape_uri(ngx.var.request_uri))
        end
    }
}

location = /_authz/apps/index.html {
    alias /usr/local/openresty/nginx/html/admin/index.html;
    default_type text/html;
    ssi on;
    gzip on;
    gzip_comp_level 7;
    gzip_vary on;
    gzip_min_length 256;
    expires off;
    access_by_lua_block {
        local authz = require "resty.authz"
        require("resty.authz.db").open(authz.config.db_path)
        local session = require "resty.authz.session"
        local token = session.get_request_token()
        local current = token and session.get(token)
        if not current then
            return ngx.redirect("/_authz/login?next=" .. ngx.escape_uri(ngx.var.request_uri))
        end
    }
}

location ^~ /_authz/apps/ {
    alias /usr/local/openresty/nginx/html/admin/;
    gzip on;
    gzip_comp_level 7;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types
        application/javascript
        application/json
        application/manifest+json
        application/xml
        image/svg+xml
        text/css
        text/plain
        text/xml;
    expires max;
    access_by_lua_block {
        local authz = require "resty.authz"
        require("resty.authz.db").open(authz.config.db_path)
        local session = require "resty.authz.session"
        local token = session.get_request_token()
        local current = token and session.get(token)
        if not current then
            return ngx.redirect("/_authz/login?next=" .. ngx.escape_uri(ngx.var.request_uri))
        end
    }
}

location ^~ /_authz/ {
    default_type text/html;
    content_by_lua_block {
        require("resty.authz.router"):handle()
    }
}

# ── 文件浏览模块（fancyindex 目录索引）───────────────────────────
# 挂载到容器的 html 目录（ADMIN_UI_DIR → /usr/local/openresty/nginx/html/admin）
# 以 /files/ 作为只读浏览入口；fancyindex 渲染目录列表，支持直接下载。
# index 指向不存在的文件以强制回落到 fancyindex 列表（admin 首页是 SSI 页，
# 统一走 /_authz/apps/ 会话入口）。未登录时与其他入口一致跳转登录页。
location = /files {
    return 301 /files/;
}

location /files/ {
    alias /usr/local/openresty/nginx/html/admin/;
    index .fancyindex-forbidden;
    fancyindex on;
    fancyindex_exact_size off;
    fancyindex_time_format "%Y-%m-%d %H:%M";
    fancyindex_header "";
    fancyindex_footer "";
    access_by_lua_block {
        local authz = require "resty.authz"
        require("resty.authz.db").open(authz.config.db_path)
        local session = require "resty.authz.session"
        local token = session.get_request_token()
        local current = token and session.get(token)
        if not current then
            return ngx.redirect("/_authz/login?next=" .. ngx.escape_uri(ngx.var.request_uri))
        end
    }
}

location / {
    set $authz_target "";
    set $authz_user   "";
    set $authz_source "";
    set $authz_identity "";
    set $authz_websocket "0";
    set $authz_upgrade "";
    set $authz_connection "";
    set $authz_upstream_host "";
    set $authz_proxy_forwarded_host "";
    set $authz_forwarded_proto "";
    set $authz_forwarded_port "";
    set $authz_real_ip "";
    set $authz_forwarded_for "";
    set $authz_origin "";
    set $authz_forwarded "";
    set $authz_upstream_ssl_name "";
    set $authz_upstream_cookie "";
    access_by_lua_block {
        require("resty.authz").access()
    }
    proxy_pass $authz_target;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name $authz_upstream_ssl_name;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth 5;
    proxy_set_header Host              $authz_upstream_host;
    proxy_set_header X-Real-IP         $authz_real_ip;
    proxy_set_header X-Forwarded-For   $authz_forwarded_for;
    proxy_set_header X-Forwarded-Proto $authz_forwarded_proto;
    proxy_set_header X-Forwarded-Port  $authz_forwarded_port;
    proxy_set_header X-Authz-User      $authz_user;
    proxy_set_header X-Authz-Source    $authz_source;
    proxy_set_header X-Authz-Identity  $authz_identity;
    proxy_set_header X-Authz-Key       "";
    proxy_set_header Cookie            $authz_upstream_cookie;
    proxy_set_header X-Forwarded-Host  $authz_proxy_forwarded_host;
    proxy_set_header Origin            $authz_origin;
    proxy_set_header Forwarded         $authz_forwarded;
    proxy_set_header Upgrade           $authz_upgrade;
    proxy_set_header Connection        $authz_connection;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

# 用户自定义附加配置（外置可编辑：conf/server_inc.conf，
# 由入口脚本在文件缺失时自动生成默认内容；位于本 server 配置最末尾，
# 可同时追加 location / 覆盖网关行为，修改后重建或重启容器生效）
include server_inc.conf;

# HTTPS bindings that explicitly disable certificate verification are routed
# here by resty.authz after authentication and Casbin authorization.  Keep
# this named location private so it cannot bypass the gateway access phase.
location @authz_proxy_insecure {
    internal;
    proxy_pass $authz_target;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name $authz_upstream_ssl_name;
    proxy_ssl_verify off;
    proxy_set_header Host              $authz_upstream_host;
    proxy_set_header X-Real-IP         $authz_real_ip;
    proxy_set_header X-Forwarded-For   $authz_forwarded_for;
    proxy_set_header X-Forwarded-Proto $authz_forwarded_proto;
    proxy_set_header X-Forwarded-Port  $authz_forwarded_port;
    proxy_set_header X-Authz-User      $authz_user;
    proxy_set_header X-Authz-Source    $authz_source;
    proxy_set_header X-Authz-Identity  $authz_identity;
    proxy_set_header X-Authz-Key       "";
    proxy_set_header Cookie            $authz_upstream_cookie;
    proxy_set_header X-Forwarded-Host  $authz_proxy_forwarded_host;
    proxy_set_header Origin            $authz_origin;
    proxy_set_header Forwarded         $authz_forwarded;
    proxy_set_header Upgrade           $authz_upgrade;
    proxy_set_header Connection        $authz_connection;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}
