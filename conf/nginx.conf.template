# OpenResty Authz Gateway 配置模板
# 由 docker-entrypoint.sh 用 envsubst 生成 nginx.conf
# 变量: HTTP_LISTEN HTTP_SERVER_DIRECTIVE HTTPS_PORT CERT_FILE CERT_KEY

worker_processes ${WORKER_PROCESSES};
# 容器内以 root 运行 worker, 保证挂载卷中的 SQLite 可写
user root;
error_log /usr/local/openresty/nginx/logs/error.log warn;
pid       logs/nginx.pid;

# 把这几个变量显式保留给 worker。
# 【为什么必须写 env】nginx 在 exec 后会清空 worker 的环境块：只有在 nginx.conf
# 主上下文里用 `env NAME;` 声明过的变量，worker / ngx.timer 协程里的 os.getenv
# 才读得到（实测：未声明时 master 里读到 /data/store，worker 里是 nil）。
# 本项目绝大多数配置都在 init_by_lua（master）里一次性读进运行时表，所以原本不
# 需要这些声明；但下面三类变量在**运行期**还会被直接读：
#   AUTHZ_S3_TMP_DIR  → s3_upload.lua 在请求上下文里取暂存目录（未声明时永远退成
#                       /data/s3tmp，即运维改了这个 env 也白改）；
#   AUTHZ_STORE_DIR / AUTHZ_STORE_DEFAULT_EXPIRY_HOURS / AUTHZ_FILES_ROOT
#                     → maintenance 定时器与本机保存区相关代码。
# Lua 侧（config.store_dir 等）另外做了 master 阶段记忆兜底，这一层是双保险；
# 变量未设置时 nginx 只是不注入，不会报错。
env AUTHZ_S3_TMP_DIR;
env AUTHZ_STORE_DIR;
env AUTHZ_STORE_DEFAULT_EXPIRY_HOURS;
env AUTHZ_FILES_ROOT;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    # Default response compression. Static files with a sibling .br file use
    # Brotli directly; other responses fall back to dynamic Brotli/Gzip.
    brotli on;
    brotli_comp_level 5;
    brotli_static on;
    brotli_types
        application/javascript
        application/json
        application/manifest+json
        application/xhtml+xml
        application/xml
        image/svg+xml
        text/css
        text/csv
        text/javascript
        text/plain
        text/xml;
    gzip on;
    gzip_comp_level 5;
    gzip_vary on;
    gzip_min_length 256;
    # 代理响应默认也要压缩：gzip_proxied 默认 off 的判据是请求是否带 Via 头
    # （不是 X-Forwarded-For），而 Brotli 没有这层门控。于是经 SLB/边缘 nginx
    # （带 Via 转发）进来的请求会拿到未压缩正文，同一条链上 Gzip 与 Brotli
    # 行为不一致。已在目标镜像实测：带 Via 时 gzip 完全不生效，去掉门控后恢复。
    # 客户端声明支持 gzip 就一定压，与上游是否压缩无关：正文改写需要上游返回
    # 未压缩字节，proxy 用独立变量把 Accept-Encoding: identity 只发给上游
    # （见 gateway.proxy.upstream_accept_encoding），客户端的协商能力保持原样。
    # text/event-stream 不在下面两个 types 列表里：压缩器会攒住事件，流式语义失效。
    gzip_proxied any;
    gzip_types
        application/javascript
        application/json
        application/manifest+json
        application/xhtml+xml
        application/xml
        image/svg+xml
        text/css
        text/csv
        text/javascript
        text/plain
        text/xml;

    # resty.authz 库路径 (LUA_PATH 已含, 此处显式兜底)
    lua_package_path "/usr/local/openresty/site/lualib/?.lua;/usr/local/openresty/site/lualib/?/init.lua;/usr/local/openresty/lualib/?.lua;/usr/local/openresty/lualib/?/init.lua;;";

    lua_shared_dict authz_cache 5m;
    lua_shared_dict authz_db_cache 10m;
    lua_shared_dict authz_login_limit 1m;
    lua_shared_dict authz_oauth_state 5m;
    # 共享会话（Redis）的熔断器与降级宽限状态，跨 worker 共享。
    # 键都是短字符串 + 小整数（ss:open / ss:fails / ss:seen:<token> ...），1m 足够。
    lua_shared_dict authz_shared_session 1m;
    resolver ${DNS_RESOLVER} ipv6=off valid=300s;
    resolver_timeout 5s;
    lua_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    lua_ssl_verify_depth 5;

    init_by_lua_block {
        require("resty.authz").init()
    }

    # 每小时一次的后台维护（到期对象清理 + 上传暂存残留扫描）。
    # init_worker 阶段每个 worker 都会跑一次 start()：内部用共享字典原子 add 抢
    # owner 锁，只有抢到的那个 worker 真正挂定时器，其余直接 return。
    # pcall 包住：模块加载失败（比如老镜像里还没有 maintenance.lua）也不能挡住启动。
    #
    # 【部署提醒】本机生产把宿主机的 conf/ 挂到容器的 /etc/openresty/templates，
    # 模板改动必须同步到部署目录（cp conf/nginx.conf.template
    # /data/app/data/authz/conf/）再重启才生效；改仓库里的模板本身不会动到运行实例。
    init_worker_by_lua_block {
        local ok, m = pcall(require, "resty.authz.maintenance")
        if ok then m.start() end
        -- 共享会话待写队列的重放循环（同样只由 worker 0 挂链，内部抢 owner 锁）。
        -- 未启用共享会话时 start() 直接 return false，不产生定时器。
        local ok2, sync = pcall(require, "resty.authz.shared_session_sync")
        if ok2 then sync.start() end
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # /_authz/apps/ 静态资源缓存策略：HTML 是入口，必须每次回源校验（否则升级后
    # 浏览器会一直用旧 HTML + 旧版本位的 JS）；带 ?v=N 版本位的 js/css/字体仍强缓存。
    map $uri $authz_apps_expires {
        ~*\.html$   -1;
        default     max;
    }

    map $http_x_forwarded_host $authz_request_host {
        default $http_x_forwarded_host;
        ""      $http_host;
    }

    # 动态流式响应（SSE 等）默认禁用下游代理缓冲：向上游边缘代理声明
    # X-Accel-Buffering: no；其它 Content-Type 不加该头。
    map $sent_http_content_type $sse_no_buffer {
        ~*text/event-stream  no;
        default              "";
    }

    # 文件预览（/_authz/files/*.html?authz_preview=1）注入一段 ESC 转发脚本：
    # 沙箱 iframe 内的按键不会冒泡到父页面，导致全屏预览里按 ESC 关不掉。
    # 注入脚本把 ESC 用 postMessage 转给父页面（files.html 监听后关闭预览）。
    # 仅 ?authz_preview=1 时注入；下载/直接打开命中 default（替换为等价文本，
    # 内容不变），落盘字节与线上原文件一致。sub_filter 只在 text/html 上生效。
    map $arg_authz_preview $authz_files_head_close {
        1       "<script>document.addEventListener('keydown',function(e){if(e.key==='Escape'&&window.parent!==window){window.parent.postMessage({type:'authz-files-esc'},'*')}});</script></head>";
        default "</head>";
    }

    # Some outer proxies preserve the hostname but replace the public port.
    # Restore the Origin authority only when its hostname matches the request
    # hostname; a genuinely cross-origin hostname keeps the request Host.
    map "$http_origin|$authz_request_host" $authz_forwarded_host {
        default $authz_request_host;
        ~*^https?://([^/:]+)(:\d+)?\|\1(?::\d+)?$ $1$2;
    }

    server {
        listen ${HTTP_LISTEN};
        server_name _;
        ${HTTP_SERVER_DIRECTIVE}
    }

    server {
        listen ${HTTPS_PORT} ssl;
        server_name _;

        ssl_certificate     ${CERT_FILE};
        ssl_certificate_key ${CERT_KEY};
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header Strict-Transport-Security "max-age=31536000" always;
        include server.conf;
    }

    # 用户自定义 http 层附加配置（外置可编辑，见 conf/http_inc.conf）
    include http_inc.conf;
}

# 用户自定义 stream 层附加配置（外置可编辑，见 conf/stream_inc.conf）
stream {
    include stream_inc.conf;
}
