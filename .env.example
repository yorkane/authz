AUTHZ_HOST_URL=https://your-public-host.example
AUTHZ_COOKIE_DOMAIN=.example.com
# ── 管理员 ──────────────────────────────────────────────
# 首次启动 seed 的 admin 密码 (仅 users 表为空时生效; 登录后请立即改密)
AUTHZ_ADMIN_PASSWORD=change-me-strong-password

# ── 网络 ────────────────────────────────────────────────
# Nginx worker 数量，默认 4；按 CPU 核数和连接数调整。
NGINX_WORKER_PROCESSES=4
# 入口端口: 6080/6443 均代理本机 http 服务 (6443 在网关终止 TLS)
AUTHZ_HTTP_PORT=6080
AUTHZ_HTTPS_PORT=6443
# redirect（默认）把公网 HTTP 308 到 HTTPS；disabled 只监听 127.0.0.1；
# serve 仅用于已有可信 TLS 终止层或受控测试环境。
AUTHZ_HTTP_MODE=redirect

# 数字前缀子域名允许的端口范围 (如 3000-foo.example.com → 本机3000)
AUTHZ_PORT_MIN=2000
AUTHZ_PORT_MAX=20000
# Docker Desktop 无法从容器监听表发现时，追加探测端口，例如 3080,8082
AUTHZ_DISCOVERY_PORTS=
# WebSocket 按域名绑定单独配置：管理端“新增域名绑定”中开启 WebSocket，
# 不使用全局环境变量，避免普通 HTTP 域名意外转发升级请求。

# 管理菜单发现本机 HTTP 服务的缓存与探测超时
AUTHZ_DISCOVERY_TTL=30
AUTHZ_DISCOVERY_CONNECT_TIMEOUT_MS=100
AUTHZ_DISCOVERY_READ_TIMEOUT_MS=200
AUTHZ_DB_CACHE_TTL=30
AUTHZ_DB_CACHE_LRU_SIZE=500

# ── 存储 ────────────────────────────────────────────────
# 宿主机数据目录 (SQLite 数据库 + 自签证书), 必须持久化
DATA_DIR=./data

# 宿主机管理前端目录 (只读挂载，修改前端后刷新浏览器即可，无需重建镜像)
ADMIN_UI_DIR=./admin

# 宿主机项目 Lua 库目录 (只读挂载，与镜像内 site/lualib 完全一致)
LUALIB_DIR=./lualib

# SQLite 文件路径 (容器内)
AUTHZ_DB_PATH=/data/authz/authz.db
# 自签证书目录 (容器内, 缺失时自动生成 10 年期证书)
AUTHZ_CERT_DIR=/data/certs
# 文件浏览应用的只读根目录 (容器内路径, 默认 /files)。
# 默认配合 docker-compose 的 FILES_DIR 卷挂载: ${FILES_DIR:-./files} -> /files。
# 修改本变量时必须同步 server.conf 里 /_authz/files/ 的 alias，否则列表与预览路径不一致。
# AUTHZ_FILES_ROOT=/files
# 文件浏览挂载的宿主目录 (默认项目下 ./files)
FILES_DIR=./files

# ── 会话 ────────────────────────────────────────────────
# 会话有效期 (秒), 默认 7 天
AUTHZ_SESSION_TTL=86400
# 登录防护：失败登录延迟返回，按「账户名+来源 IP」连续失败达阈值后锁定该账户组合
# 同一账户（账户名+IP）连续失败多少次后锁定（>=1，默认 5）
AUTHZ_LOGIN_ATTEMPTS=5
# 失败计数窗口 = 锁定时长（秒，>=60，默认 1800=30 分钟）
AUTHZ_LOGIN_WINDOW=1800
# 登录失败后延迟多少毫秒再返回（0-10000，默认 1000，防暴力枚举计时探测）；不锁定同 IP 其他账户
AUTHZ_LOGIN_FAIL_DELAY_MS=1000

# ── Agent 专用 API Key（可选）──────────────────────────
# 设置后启动时自动创建名为 agent-default 的 key（角色 admin，仅限本机回环调用）。
# 值格式: ak_<64 位小写 hex>，例如 openssl rand -hex 32 生成后再加 ak_ 前缀。
# 留空或不设置则不创建。
AUTHZ_AGENT_API_KEY=
# ── 实例级预置 API Key（Agent 免登录，可选）────────────────
# 设置后即可用 `x-api-key: <值>` 请求头免登录访问控制面 API、管理页面与代理入口，
# Agent 不必再手动登录取 Cookie（curl -H / Playwright setExtraHTTPHeaders 均可）。
# 长度 32-256 且不含空格与控制字符，例如: openssl rand -hex 32
# 留空即完全关闭。该 Key 不入库，权限仍按角色走 Casbin 策略；随容器环境变量轮换。
AUTHZ_API_KEY=
# Key 角色（admin/staff/user/viewer/api），默认 admin；只需读权限时收窄为 viewer。
AUTHZ_API_KEY_ROLE=admin
# true 时只接受本机回环来源（127.0.0.0/8），跨机调用一律 401。对外暴露实例时强烈建议 true。
AUTHZ_API_KEY_LOOPBACK=false

# 生产入口始终为 HTTPS（包括 TLS 在上游终止且不透传协议头）时设为 true。
AUTHZ_COOKIE_SECURE=true
# 动态端口跨子域共享会话时设置；可逗号分隔多个父域，匹配当前 Host 后逐个输出 Set-Cookie。
# 不同注册域不能靠 Cookie Domain 互传；应由各入口分别承载 Cookie，并共享 Redis 会话。
AUTHZ_COOKIE_DOMAIN=.example.com

# ── 共享会话 (Redis) ───────────────────────────────────
# 默认关闭；Redis ACL、网络隔离和传输保护完成前不要开启。
# 多实例只允许一个认证主实例使用 read-write，其余实例必须使用 read-only。
# 仅共享登录身份; Casbin 策略、绑定、角色覆盖仍由各实例本地管理, 不做同步。
# 会话命中后仍会用本地 users / remote_users 校验身份, 本地不存在或已禁用即清除登录。
AUTHZ_SESSION_SHARED=false
# redis://<host>[:<port>]，默认端口 6379。
AUTHZ_SESSION_REDIS_URL=redis://192.168.1.30:6379
# 主实例: read-write；其余实例: read-only。未填写时安全默认 read-only。
AUTHZ_SESSION_REDIS_MODE=read-only
# 为 writer/reader 创建不同 Redis ACL 用户；不要让 reader 拥有 SETEX/DEL/SCAN。
AUTHZ_SESSION_REDIS_USERNAME=authz-reader
AUTHZ_SESSION_REDIS_PASSWORD=
AUTHZ_SESSION_REDIS_DB=0
# 多套集群共用同一 Redis 时, 用前缀隔离。
AUTHZ_SESSION_REDIS_PREFIX=authz
# 共享会话记录的 HMAC-SHA256 签名密钥（>=32 字符，所有共享实例必须一致）。
# 共享 Redis 常有其他可写入方：未签名/签名不符的记录一律拒绝，防止伪造会话。
# 生成方式: openssl rand -hex 32
AUTHZ_SESSION_SIGNING_KEY=

# ── 响应改写缓冲预算 ───────────────────────────────────
# 正文改写（body / rewrites）需要在 worker 内缓冲整个响应。单个响应上限固定 1MB，
# 并按此上限整块预留 worker 级预算；预算耗尽的新响应自动跳过改写、原样流式透传
# （响应头带 X-Authz-Rewrite: skipped=memory）。仅影响正文改写，状态码与响应头
# 改写不需要缓冲。默认 64（MB）。
AUTHZ_REWRITE_BUFFER_MB=64



AUTHZ_DINGTALK_ENABLED=false
AUTHZ_DINGTALK_CLIENT_ID=your-dingtalk-client-id
AUTHZ_DINGTALK_CLIENT_SECRET=your-dingtalk-client-secret
AUTHZ_DINGTALK_REDIRECT_URI=https://your-public-host.example/_authz/oauth/callback
AUTHZ_DINGTALK_DEFAULT_ROLES=viewer

AUTHZ_NOCO_API_KEY=your-nocobase-api-key
AUTHZ_NOCO_URL=https://your-nocobase-host.example/

# NocoBase OAuth Client（由 scripts/register_nocobase_oauth.py 管理）
AUTHZ_NOCO_OAUTH_ENABLED=true
AUTHZ_NOCO_OAUTH_CLIENT_ID=your-nocobase-oauth-client-id
AUTHZ_NOCO_OAUTH_CLIENT_SECRET=your-nocobase-oauth-client-secret
AUTHZ_NOCO_OAUTH_REDIRECT_URI=https://your-public-host.example/_authz/oauth/callback


AUTHZ_GOOGLE_ENABLED=true
AUTHZ_GOOGLE_CLIENT_ID=your-google-client-id
AUTHZ_GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTHZ_GOOGLE_REDIRECT_URI=https://your-public-host.example/_authz/oauth/callback
AUTHZ_GOOGLE_DEFAULT_ROLES=viewer
