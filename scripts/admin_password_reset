#!/bin/sh
set -eu

if [ "$#" -ne 0 ]; then
    echo "usage: admin_password_reset" >&2
    exit 2
fi

/usr/local/openresty/luajit/bin/luajit \
    /usr/local/openresty/admin_password_reset.lua

# The application caches user records in worker memory.  Reloading creates
# fresh workers so a direct SQLite update takes effect immediately.
/usr/local/openresty/bin/openresty -s reload
echo "OpenResty reloaded"
